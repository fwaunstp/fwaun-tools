# Example fwaun-tools configuration.
#
# Drop this file into a dataset directory as `fwaun-tools.toml` for
# project-local options, or keep a copy at
# `~/.config/fwaun-tools/config.toml` (resp.
# `$XDG_CONFIG_HOME/fwaun-tools/config.toml`) for user-wide defaults.
# Per-directory entries win on key collision; everything is optional and
# falls back to the built-in defaults if the file is absent.

# Selectors: which profile each subcommand uses when invoked without
# `--profile` / `--model`. Comment any of them out to fall back to the
# built-ins (anima export profile, wd-eva02-large-v3 tagger,
# qwen3-vl-4b captioner).
default_profile   = "anima"
default_tagger    = "wd-eva02-large-v3"
default_captioner = "qwen3-vl-4b"

# Dataset-wide manual tags. Same syntax as a sidecar's `manual_tags`:
# `foo` positive, `-foo` suppression, `_foo` curation-only (never exported).
# They apply to EVERY image in the dataset without being written into any
# `.ron`, so images added later are covered automatically and removing an
# entry here removes it everywhere.
#
# The typical character-LoRA setup: the trigger word, plus suppressions for
# the traits that should be absorbed INTO that trigger rather than learned as
# separate tags. Without them the tagger re-adds `red_hair` to every new
# image and the model ties the appearance to the colour tag instead of the
# character name.
#
# Common positives are emitted first, so the trigger word heads the exported
# tag string. An image opts out of any entry by naming the same tag itself,
# in any form — a per-image `red_hair` cancels the `-red_hair` below for that
# image alone, and a per-image `-himeko` drops the trigger from a shot the
# character isn't in.
#
# This list does NOT merge across config levels: a non-empty project-level
# list replaces the user-level one outright.
#
# Editing: a bulk tag edit covering the whole dataset lands here rather than
# in the sidecars — `dataset add-tag <root> --tags=...` (pass `--per-image`
# to force the old per-sidecar behaviour), or the GUI's tag input with every
# image selected. Those edits are surgical, so the comments above survive.
common_tags = []
# common_tags = ["himeko", "-red_hair", "-yellow_eyes", "-slit_pupils", "-horns"]

# ---------------------------------------------------------------------------
# Export profiles — control how tags/captions are filtered/formatted on
# `export` (one .txt per image) and `metadata`. `metadata --format
# sd-scripts` writes one meta.json (tags + captions); `metadata --format
# musubi` writes a caption-only meta.jsonl for musubi-tuner.
# ---------------------------------------------------------------------------

[export.anima]
# Score cutoff applied to auto tags at export time.
threshold = 0.35
# sd-scripts shuffles tag order at training time, so leave this off.
shuffle = false
# Drop auto tags whose category is in this list (e.g. "meta", "rating").
exclude_categories = []

# Per-category prefix applied to auto tags. ANIMA expects `@artist_name`.
[export.anima.category_prefixes]
artist = "@"

[export.plain]
threshold = 0.35
shuffle = false
exclude_categories = []

# (no per-category prefixes for plain training)
[export.plain.category_prefixes]

# Caption-only profile for musubi-tuner (`metadata --format musubi`) or any
# caption-driven trainer. The caption carries the description; tags that mark
# a controllable mode are folded into a deterministic caption prefix instead
# of being emitted as tags.
[export.musubi]
threshold = 0.35
shuffle = false
exclude_categories = []

# Caption-only output → no per-category tag prefixes.
[export.musubi.category_prefixes]

# Fold curation tags into a caption prefix. On caption export, if the image
# has a positive manual tag matching a key here (matched case-insensitively,
# a leading organizational `_` is ignored), the value is prepended verbatim
# to the caption — include your own trailing separator. Multiple matches are
# emitted in key order. Example below: a head-to-body trigger for a single
# art-style LoRA. Give every mode its own explicit token (including the
# "default" look) — an unmarked default tends to drift toward whichever mode
# dominates the set rather than staying put.
[export.musubi.caption_prefixes]
realistic = "realistic proportions, "
standard = "stylized proportions, "
super_deformed = "super deformed, "

# Caption suffixes — same matching as prefixes, but appended to the end.
# Use these for trainers / inference templates that expect the trigger word
# as a trailing tag. ComfyUI's Krea-2 template, for instance, concatenates
# the LoRA trigger onto the end of the prompt (`{prompt}, {trigger}`) using a
# natural-language "... style" phrase, so a caption trained the same way
# (`{description}, {trigger}`) lines up at inference. Include your own leading
# separator (here `", "`). Configure prefixes OR suffixes per profile — you
# don't normally want both.
[export.musubi.caption_suffixes]
realistic = ", fwaun style, realistic proportions"
standard = ", fwaun style, stylized proportions"
super_deformed = ", fwaun style, chibi proportions"

# ---------------------------------------------------------------------------
# Captioner prompt library — define each prompt once here and reference
# it by name from any captioner profile's `prompts = [...]`. The built-in
# `default` is always available; redefining it here overrides the
# built-in. Per-image specifics (character names + positions) belong in
# the sidecar's `caption_hints` list — edited like tags in the GUI, and
# batch-added across a whole character — not in these prompts.
#
# Write ONLY the description task here. The hint / prefix machinery wraps
# your prompt automatically at generation time, so instructions like "use
# the names below" or "continue from this opening" must NOT be repeated in
# the prompt text. The user turn is assembled as:
#
#   [when the image has caption_hints or a matching tag_group caption_hint]
#     Use the following names and details when describing the image:
#     - <hint>
#     - <hint>
#
#   <your prompt text>
#
#   [when a tag_group caption_prefix matches]
#     The caption has already been started with the exact text below. Write
#     only what comes next, as one continuous description that flows on
#     naturally from it. Do not repeat or rephrase this opening, and do not
#     add any preamble before your continuation:
#
#     <prefix>
# ---------------------------------------------------------------------------

[captioner_prompts]
# The built-in `default`, spelled out. Leave it commented to keep this exact
# text; uncomment and edit to override the baseline for every profile that
# lists `"default"`. It is sized to fit inside ANIMA's 512-token ceiling.
# default = "Describe this image in detail in 3-5 sentences (under 200 words)."

# Character-focused prompt: useful for character LoRAs where you want
# the model to weave per-character details into the description.
# Combine with `caption_hints` (one fact per entry, e.g. "blue hair girl
# is Laundry Dragonmaid") to lock in names — the captioner sees them as a
# bullet list at generation time and stitches them into one cohesive
# caption rather than a manual prefix. In the GUI you add a hint to every
# selected image at once, so a shared fact covers a whole character.
character = "Describe this image with attention to each person — their appearance (hair, clothing, expression), pose, and where they sit in the frame. 3-5 sentences, under 200 words."

# ---------------------------------------------------------------------------
# Tagger profiles — HuggingFace-hosted WD14-family models. Models are
# downloaded into the shared hf-hub cache on first use.
# ---------------------------------------------------------------------------

[tagger.wd-eva02-large-v3]
repo = "SmilingWolf/wd-eva02-large-tagger-v3"
# Pin a branch / tag / commit. Defaults to the repo's `main` if omitted.
revision = "main"
input_size = 448
# Tags scoring below this are dropped before being stored in the sidecar,
# leaving room to re-filter with a lower `threshold` at export time
# without re-running inference.
storage_threshold = 0.10

# ---------------------------------------------------------------------------
# Captioner profiles. Use `kind = "onnx"` for a local HF-hosted ONNX
# pipeline, or `kind = "openai"` to call any OpenAI-compatible
# chat-completions endpoint (llama.cpp, koboldcpp, Ollama, LM Studio,
# vLLM, ...).
#
# Token budget note: ANIMA is trained with qwen3_max_token_length =
# t5_max_token_length = 512 (kohya-ss anima_train_network defaults), so
# captions longer than ~512 tokens get truncated at training time.
#
# IMPORTANT: each captioner's `max_new_tokens` / `max_tokens` is measured
# in *that captioner model's own tokenizer*, NOT ANIMA's. The numbers
# don't compare directly:
#   * Qwen3-VL (ONNX) shares Qwen3 vocab with ANIMA, so 512 here ≈ 512
#     ANIMA tokens. Don't go over.
#   * Gemma-3 / other OpenAI backends use different vocabs that need
#     1.5-2.3x more tokens to encode the same English prose. So 512 of
#     Gemma's tokens often comes out to ~250 ANIMA tokens — the cap
#     becomes overly conservative and produces mid-sentence cutoffs.
#     Bump `max_tokens` to 800-1024 for those backends; the prompt's
#     length cap (`under 200 words`) still keeps prose bounded, and you
#     can verify against ANIMA's real budget with `fwaun-tools dataset tokens`.
#
# `prompts = ["..."]` is a list of names looked up in
# `[captioner_prompts]`. Each named prompt produces its own caption
# entry under the same loaded model, keyed `{profile}.{name}` in the
# sidecar — so adding a prompt is essentially free (one extra inference
# per image, no extra model load). Omit the field to default to
# `["default"]`.
# ---------------------------------------------------------------------------

[captioner.qwen3-vl-4b]
kind = "onnx"
repo = "onnx-community/Qwen3-4B-VL-ONNX"
revision = "main"
# onnx-community packs multiple variants per repo under variant-named
# subdirectories. Leave empty / `""` for forks that put the ONNX files
# at the repo root.
subdir = "qwen3-vl-4b-instruct-onnx-vision-fp32-text-int4-cpu"
# Smart-resize area cap (~768x768). Larger = richer captions, quadratically
# slower decode.
max_pixels = 589824
max_new_tokens = 512
# Regenerate when the caption comes back empty (trims to nothing). After the
# retries are used up the empty result is reported as an error instead of being
# saved, so the key stays un-generated and a later run retries it rather than
# leaving a blank caption behind. 0 = never retry. (Greedy ONNX decode is
# deterministic, so a retry reproduces the same output — this mainly governs how
# many attempts run before the empty result surfaces as an error.)
empty_retries = 2
prompts = ["default"]

[captioner.local-llamacpp]
kind = "openai"
# Base URL up to and including `/v1` (we append `/chat/completions`).
endpoint = "http://localhost:8080/v1"
# Sent verbatim as the chat-completions `model` field. Many local servers
# ignore it; some require a non-empty value.
model = "local"
# Bearer token. Empty string / omit for unauthenticated local servers.
api_key = ""
# Counted in this server's tokenizer, not ANIMA's. Bump to 800-1024
# for Gemma-style models if you see mid-sentence truncation; verify
# with `fwaun-tools dataset tokens` after generation.
max_tokens = 512
temperature = 0.7
# Resize so the longest edge is at most this many pixels before sending.
# 0 = send the file bytes verbatim.
max_edge = 1024
jpeg_quality = 90
# Per-request timeout. CPU-bound local servers can need several minutes
# for a single caption.
timeout_secs = 600
# Retry a request that fails with a transient error (HTTP 5xx or a
# transport/network failure) up to this many times before giving up. Helps
# with servers that intermittently 500 — e.g. gpt-oss harmony parse errors.
# 0 = never retry.
max_retries = 3
# Regenerate when the server returns an empty caption (trims to nothing) —
# separate from `max_retries`, which handles transient HTTP failures. Useful
# when a reasoning model spends its whole budget in the thinking channel, or a
# context-length overflow yields no content. After the retries are used up the
# empty result is reported as an error instead of being saved. 0 = never retry.
empty_retries = 2
# Run two prompts per image: one general description and one focused on
# characters. Both share the same loaded model.
prompts = ["default", "character"]

# ---------------------------------------------------------------------------
# Tag groups — declare sets of tags that should be mutually exclusive on
# each image. Used by `fwaun-tools dataset validate-tag-group` and the GUI's
# Kanban view to bucket images per-tag, plus an "unset" and "violation"
# (multiple tags coexisting) bucket.
#
# Two or more group tags coexisting on one image is a "violation", but
# this is informational rather than an error — character setting sheets
# legitimately show multiple costumes in one frame.
# ---------------------------------------------------------------------------

# Costume separation for a character LoRA where the official material
# offers a school uniform and lounge wear. Each training image should
# fall into exactly one of: `official_school_uniform`,
# `official_lounge_wear`, or "unset" (use `-foo` markers in
# `manual_tags` to opt out of both).
[tag_group.official_costumes]
tags = ["official_school_uniform", "official_lounge_wear"]

# Single-tag groups are valid too — handy for "is tag X set or not?"
# curation passes. Uncomment and edit:
# [tag_group.solo_check]
# tags = ["solo"]

# Curation-only "organizational" tags: a positive manual entry starting with
# an underscore (`_foo`) is kept in the data and counted for tag-group
# classification, but is NEVER written to the exported `.txt`. This lets you
# tell apart "not yet reviewed" (no group tag at all → the Kanban "unset"
# column) from "reviewed, deliberately none of these" (an organizational tag).
# Add such a tag as a group member to give "confirmed none" its own column:
# [tag_group.character]
# tags = ["character_a", "character_b", "_no_character"]

# ---------------------------------------------------------------------------
# Caption steering from tag groups. A group can carry a `caption_hint`,
# `caption_prefix`, and/or `caption_suffix`. They apply when ALL of the
# group's `tags` are present on an image (logical AND), matched against the
# image's positive manual tags. This drives:
#   - GENERATION: the hint is fed to the captioner as a reference fact, and
#     the prefix primes the model (assistant-turn prefill) so its output
#     continues from it naturally. Only the continuation is stored.
#   - EXPORT: the prefix/suffix are folded into the caption written to the
#     musubi / sd-scripts metadata (`metadata --format musubi|sd-scripts`),
#     so the stored body + prefix line up exactly.
#
# `exclusive` (default true) is the mutual-exclusivity flag used by
# `validate-tag-group` and the Kanban view. Steering groups whose member
# tags are meant to CO-OCCUR set `exclusive = false`, so co-occurrence isn't
# flagged as a violation (and the group is hidden from the Kanban board).
#
# When several groups' prefixes match one image, they concatenate in
# ascending `priority`; suffixes likewise. Include your own separator in
# `content` (a trailing `", "` for a prefix, a leading `", "` for a suffix).
#
# Groups that share a `priority` are ordered PER IMAGE instead of by name:
# see the style-LoRA example further down for why, and what stays stable.
[tag_group.style_realistic]
tags = ["realistic"]
exclusive = false
caption_hint = "The rendering style is photorealistic."
[tag_group.style_realistic.caption_prefix]
content = "realistic proportions, "
priority = 0
[tag_group.style_realistic.caption_suffix]
content = ", photorealistic style"
priority = 0

# Single-character multi-costume: put the character name first (priority 0)
# and the costume after (priority 1) so the caption reads
# "Sayaka from Saru getchu. She wears her Fantasy Knight costume. <body>".
# [tag_group.char_sayaka]
# tags = ["sayaka"]
# exclusive = false
# [tag_group.char_sayaka.caption_prefix]
# content = "Sayaka from Saru getchu. "
# priority = 0
# [tag_group.costume_fantasy_knight]
# tags = ["fantasy_knight"]
# exclusive = false
# [tag_group.costume_fantasy_knight.caption_prefix]
# content = "She wears her official Fantasy Knight costume. "
# priority = 1

# Style LoRA over independent axes — this is what EQUAL priorities are for.
# Training the four combinations of "chibi or not" x "realistic background or
# not" with a fixed prefix order teaches the ORDER along with the concepts, so
# the two below share `priority = 0` and each image gets one of
#   "chibi style. realistic background. "
#   "realistic background. chibi style. "
# The pick is a hash of the image's path relative to THIS FILE's directory
# (extension dropped), not a random draw, so:
#   - the captioner is primed with the same prefix export later prepends;
#   - re-running `metadata` on an unchanged dataset produces an identical
#     file — no spurious diff;
#   - moving the dataset, or cloning it to another machine, keeps every
#     image's order; renaming an image or moving it between subdirectories
#     rerolls that one image.
# Give the groups different priorities if you do want a fixed order.
# [tag_group.style_chibi]
# tags = ["chibi"]
# exclusive = false
# [tag_group.style_chibi.caption_prefix]
# content = "chibi style. "
# priority = 0
# [tag_group.style_realistic_background]
# tags = ["realistic_background"]
# exclusive = false
# [tag_group.style_realistic_background.caption_prefix]
# content = "realistic background. "
# priority = 0

# Multi-tag concept (logical AND): vary a concept trigger's phrasing by
# count/gender. Each entry fires only when BOTH its tags are present, so a
# hint is chosen per composition — better than a fixed prefix for
# multi-subject / positional descriptions the model must place itself.
# [tag_group.girl_breaking_through_fourth_wall]
# tags = ["1girl", "breaking_through_fourth_wall"]
# exclusive = false
# caption_hint = "A girl is breaking through the fourth wall."
# [tag_group.boy_breaking_through_fourth_wall]
# tags = ["1boy", "breaking_through_fourth_wall"]
# exclusive = false
# caption_hint = "A boy is breaking through the fourth wall."

# ---------------------------------------------------------------------------
# Upscaler profiles — batch-upscale a dataset through an existing ComfyUI
# server (`fwaun-tools dataset upscale <dir>`). Each image is uploaded over
# ComfyUI's HTTP API, run through an upscale workflow, and the result written
# to a separate output directory (default: a `<dir>_upscaled` sibling), with
# each `.ron` sidecar copied alongside. Run `fwaun-tools dataset upscale-models`
# to list the model filenames the server offers.
#
# Select one without `--profile` by setting `default_upscaler` at the top of
# this file (left unset here so the built-in default — local ComfyUI, no model
# — applies until you configure one).
# ---------------------------------------------------------------------------

# Model-based (ESRGAN-style) upscaler using the built-in workflow. This is the
# fast, faithful default for datasets: no diffusion, just the upscale model.
[upscaler.esrgan]
# ComfyUI server root. Defaults to the stock local install if omitted.
base_url = "http://127.0.0.1:8188"
# Upscale-model filename as it appears in ComfyUI's models/upscale_models/.
# Popular picks: RealESRGAN_x4plus.pth (photo/general), 4x-UltraSharp.pth
# (sharp digital art), or an anime-tuned model for illustration linework.
upscale_model = "RealESRGAN_x4plus.pth"
# After upscaling, cap the longest edge to this many pixels (Lanczos3
# downscale when exceeded). Model upscalers emit a fixed multiplier (usually
# ×4); this keeps dataset resolutions bounded. 0 = keep the native output.
max_edge = 2048
# Per-request / whole-job timeout in seconds.
timeout_secs = 600
# Pause between /history status polls, in milliseconds.
poll_interval_ms = 750
# Advanced: use your own ComfyUI workflow instead of the built-in graph.
# Export it via ComfyUI's "Save (API Format)" and point at the JSON here. The
# single LoadImage node is fed each dataset image; the SaveImage node's output
# is retrieved. Enables diffusion-based upscalers (Ultimate SD Upscale, tiled
# img2img, …). When set, `upscale_model` is ignored.
# workflow_template = "workflows/ultimate_sd_upscale_api.json"

# Custom-workflow upscaler: drives your own API-format ComfyUI workflow (e.g.
# a diffusion-based Ultimate SD Upscale graph). `workflow_template` takes
# precedence over `upscale_model` when both are present.
[upscaler.custom]
base_url = "http://127.0.0.1:8188"
upscale_model = "RealESRGAN_x4plus.pth"
workflow_template = "workflows/ultimate_sd_upscale_api.json"
max_edge = 2048
timeout_secs = 900
poll_interval_ms = 750

# ---------------------------------------------------------------------------
# Editor profiles — apply ONE text instruction to every image in a dataset
# through an existing ComfyUI server's Gemini image (Nano Banana) API node
# (`fwaun-tools dataset edit <dir>`). Same plumbing as the upscaler: each image
# is uploaded, run through the workflow, and the result written to a separate
# output directory (default: a `<dir>_edited` sibling) with the `.ron` sidecar
# copied alongside. Run `fwaun-tools dataset edit-models` to list the `model`
# values the server's node offers (and to confirm it's installed at all).
#
# The motivating pass: an illustrated character drawn against an illustrated
# background, re-rendered with a photographic background, so the LoRA trained on
# the output learns the mixed "drawn subject over a real scene" look. Generate
# the illustrations with backgrounds first, then run this over the folder.
#
# NEEDS AN API KEY. The Gemini node is a paid "API node", and ComfyUI
# authenticates those per request — being signed into the ComfyUI web UI in a
# browser does NOT cover a run driven over the HTTP API, which fails with
# "Please login first to use this node". Generate an account API key at
# https://platform.comfy.org and export it:
#
#   export COMFY_API_KEY=comfyui-...        # PowerShell: $env:COMFY_API_KEY='comfyui-...'
#
# The `api_key` field below is read first if you prefer to keep it in a config,
# but the environment variable is the safer home: a dataset-local
# `fwaun-tools.toml` travels with the dataset, and a key committed alongside it
# is a key to your billing account.
#
# COSTS MONEY. The Gemini node is billed per image by the API provider, and a
# higher `resolution` costs more per image. `dataset edit` skips images that
# already have an output (so an interrupted run resumes for free), and
# `--dry-run` / `--limit N` let you check the count and try the prompt on a
# handful of shots before committing the whole set.
#
# Select one without `--profile` by setting `default_editor` at the top of this
# file (left unset here so nothing runs by accident until you've read the
# prompt below):
# default_editor = "nanobanana2"

[editor.nanobanana2]
# ComfyUI server root. Defaults to the stock local install if omitted.
base_url = "http://127.0.0.1:8188"
# The instruction sent with every image. Be explicit about what must NOT
# change — left to itself the model tends to photo-realise the character too,
# which is exactly the signal this dataset is meant to keep illustrated.
prompt = """
Replace the background with a photorealistic photograph of the same setting, \
matching the original's lighting direction, colour temperature and perspective. \
Keep the character exactly as drawn: same illustrated rendering, line art, cel \
shading, colours, pose, expression and position in the frame. Do not redraw, \
restyle or photo-realise the character.
"""
# `model` widget value. `dataset edit-models` prints this server's options; the
# other current one is "gemini-3-pro-image-preview" (Nano Banana Pro), which
# costs roughly twice as much per image.
model = "Nano Banana 2 (Gemini 3.1 Flash Image)"
# "auto" matches each input image's aspect ratio. Anything else re-crops the
# subject, which is rarely what a dataset pass wants.
aspect_ratio = "auto"
# Output resolution tier: "1K", "2K", or "4K". Higher tiers cost more per image.
resolution = "1K"
# The API only makes a best effort at reproducing a seed, so this bounds
# run-to-run drift rather than eliminating it.
seed = 42
# Cap the result's longest edge (Lanczos3 downscale when exceeded). 0 keeps the
# node's native output — the resolution tier above already decides the size.
max_edge = 0
# Per-request / whole-job timeout. A hosted API round trip is slower than a
# local upscale, and `thinking` models slower still.
timeout_secs = 600
# Pause between /history status polls, in milliseconds.
poll_interval_ms = 750

# Custom-workflow editor: drives your own API-format ComfyUI workflow instead of
# the built-in `LoadImage → Nano Banana → SaveImage` graph. Use it for anything
# the built-in can't express — a reference background wired in through Batch
# Images, a mask, a post-process chain. Export via ComfyUI's "Save (API Format)".
# The single LoadImage node is fed each dataset image and the SaveImage node's
# output is retrieved, exactly as for the upscaler. When set, `model` /
# `aspect_ratio` / `resolution` / `seed` are ignored — the template's own widget
# values apply.
[editor.custom]
base_url = "http://127.0.0.1:8188"
# Read before the COMFY_API_KEY environment variable. Prefer the variable —
# see the note above.
api_key = "comfyui-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
workflow_template = "workflows/nanobanana_bg_api.json"
# The prompt is written into the template's prompt widget, so one graph serves
# several profiles. Drop this key to keep whatever text the template was saved
# with.
prompt = "Replace the background with a photorealistic photograph."
# Which node to write it into. Leave unset to auto-detect the single node with a
# string `prompt` widget; set it when the template has several (the node ids are
# the top-level keys of the API-format JSON).
prompt_node = "4"
# Replace the node's built-in system prompt. Leave unset to keep it.
system_prompt = "You are an image editing engine. Apply only the requested edit and change nothing else."
model = "Nano Banana 2 (Gemini 3.1 Flash Image)"
aspect_ratio = "auto"
resolution = "1K"
seed = 42
max_edge = 0
timeout_secs = 900
poll_interval_ms = 750
